# Run this builder for linux/amd64 and linux/arm64 with Docker --platform.
FROM ubuntu:24.04
ARG TARGETARCH
ENV DEBIAN_FRONTEND=noninteractive \
    PATH="/opt/fluttery-venv/bin:${PATH}" \
    APPIMAGE_EXTRACT_AND_RUN=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    binutils build-essential ca-certificates curl desktop-file-utils pkg-config python3.12-dev \
    python3.12-venv libgtk-3-dev libgl1-mesa-dev libglu1-mesa-dev libportaudio2 \
    libnotify4 libsdl2-2.0-0 libxtst6 libwebpdemux2 libcurl4t64 libpcre2-32-0 \
    && rm -rf /var/lib/apt/lists/*

RUN python3.12 -m venv /opt/fluttery-venv && python -m pip install --upgrade pip \
    && case "$TARGETARCH" in \
        amd64) \
            cpu=x86_64; sha=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0; \
            python -m pip install https://github.com/wxWidgets/Phoenix/releases/download/wxPython-4.3.2/wxpython-4.3.2+ubuntu2404-cp312-cp312-linux_x86_64.whl#sha256=9c54b01808ee313788aab524773608eab6cf969d2a89e65257b912b2996dc0d1 ;; \
        arm64) \
            cpu=aarch64; sha=f0837e7448a0c1e4e650a93bb3e85802546e60654ef287576f46c71c126a9158; \
            python -m pip install wxPython==4.3.2 ;; \
        *) exit 1 ;; \
    esac \
    && curl --fail --location --silent --show-error \
        "https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-$cpu.AppImage" \
        --output /usr/local/bin/appimagetool \
    && printf '%s  %s\n' "$sha" /usr/local/bin/appimagetool | sha256sum -c - \
    && chmod 755 /usr/local/bin/appimagetool

WORKDIR /opt/fluttery
COPY pyproject.toml LICENSE README.md ./
COPY fluttery ./fluttery
COPY packaging ./packaging
RUN python -m pip install '.[build]'
ENTRYPOINT ["python", "packaging/build.py", "--appimagetool", "/usr/local/bin/appimagetool", "--output", "/output"]
